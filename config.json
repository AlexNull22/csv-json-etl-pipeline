{
  "inputs": [
    {"path": "samples/orders.csv"},
    {"path": "samples/orders.json", "column_map": {
      "id": "order_id", "name": "customer_name", "email": "customer_email",
      "date": "order_date", "total": "amount", "ccy": "currency", "state": "status"
    }}
  ],
  "output_dir": "output",
  "date_formats": ["%Y-%m-%d", "%Y/%m/%d"],
  "allowed_currencies": ["USD", "EUR", "GBP"],
  "allowed_statuses": ["pending", "paid", "cancelled"],
  "default_status": "pending"
}
